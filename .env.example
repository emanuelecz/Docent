# Copy this file to .env and fill in the real values.
# .env is gitignored; never commit real secrets.

# ── GitHub ────────────────────────────────────────────────────
GITHUB_PAT_KEY=your_github_personal_access_token
REPO_OWNER=pydantic
REPO_NAME=pydantic

# ── LLMs / embeddings ─────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=
VOYAGEAI_API_KEY=your_voyage_api_key

# ── PostgreSQL ────────────────────────────────────────────────
# These feed docker-compose (POSTGRES_*) and the app (DATABASE_URL).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=Docent
# Host-facing URL, used when running the app / alembic ON the host.
# Inside docker compose this is overridden to point at the `postgres` service.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/Docent

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
